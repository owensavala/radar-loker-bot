# ==========================================
# Konfigurasi Kredensial Radar Loker Bot
# Salin file ini menjadi .env untuk pengujian lokal
# ==========================================

# Token API Apify (untuk menjalankan aktor instagram-scraper)
APIFY_TOKEN=your_apify_api_token_here

# Token Bot Telegram dari @BotFather
TELEGRAM_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Chat ID atau Channel ID Telegram tujuan
CHAT_ID=1234567890

# API Key Google Gemini AI
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Model Gemini (opsional, default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
